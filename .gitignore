# 저장소 공통 항목. 프로젝트별 항목은 backend/.gitignore, frontend/.gitignore에 둔다.

# 비밀 값
.env
.env.*
!.env.example
.envrc

# 배포 구성의 설정 디렉터리 — 운영자가 둔 파일은 추적하지 않는다 (docs/operations/deployment.md "서비스")
deploy/config/*
!deploy/config/.gitkeep

# 개인 도구 설정 (각자 관리)
.claude/
CLAUDE.md
.mcp.json

# 이슈별 작업 디렉터리 (git worktree)
.worktrees/

# OS
.DS_Store
Thumbs.db

# IDE (개인 설정)
.idea/
*.iml
.vscode/
*.swp
.zed/
