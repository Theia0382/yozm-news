# 배포 구성(deploy/compose.yaml)이 읽는 값. 이 파일을 deploy/.env 로 복사해 값을 적는다.

# 필수 — 없으면 Compose 가 변수 이름을 말하며 멈춘다.
POSTGRES_PASSWORD=
# 피드 수집 요청의 User-Agent 에 밝히는 운영자 연락처 — 언론사가 요청 주체에 닿을 이메일 주소나 http · https URL.
YOZMNEWS_COLLECTION_CONTACT=

# 선택 — 수집이 연결해도 되는 내부 대역(CIDR, 쉼표 구분). 같은 망에 둔 RSS 생성기 같은 피드를 받을 때만 연다.
# 비우면 루프백 · 사설 · 링크 로컬 등 내부 주소로 가는 수집 요청을 모두 막는다.
# YOZMNEWS_COLLECTION_ALLOWED_NETWORKS=

# 선택 — 동시에 실행하는 백그라운드 작업(피드 수집 등) 수. 줄이 없으면 앱의 기본값을 쓴다.
# 값을 비운 줄(YOZMNEWS_JOB_WORKERS=)은 작업 서버의 기본값(호스트 코어 수 기준)이 되므로, 쓰지 않을 때는 줄을 지우거나 주석으로 둔다.
# YOZMNEWS_JOB_WORKERS=

# 선택 — proxy 를 공개할 호스트 주소와 포트. 기본은 이 호스트에서만 접속(127.0.0.1:8000).
# Tunnel 없이 직접 공개하는 셀프 호스팅에서만 0.0.0.0 으로 바꾼다.
# PROXY_HOST_ADDRESS=
# PROXY_HOST_PORT=

# 선택 — Compose 프로젝트 이름(기본 yozmnews-deploy). 컨테이너 · DB 볼륨 이름이 여기서 정해진다. 한 호스트에서 두 벌을 띄울 때만 바꾼다.
# COMPOSE_PROJECT_NAME=
