# 배포 구성(deploy/compose.yaml)이 읽는 값. 이 파일을 deploy/.env 로 복사해 값을 적는다.
# 변수마다 바꾸는 것은 docs/operations/configuration.md 에 있다.

# 필수 — 없으면 Compose 가 변수 이름을 말하며 멈춘다.
POSTGRES_PASSWORD=
# 운영자 연락처 — "피드 수집"
YOZMNEWS_COLLECTION_CONTACT=
# 공유 평가 Jev API 키(비밀 값) — "공유 평가"
YOZMNEWS_JEV_API_KEY=

# 선택 — 수집이 연결해도 되는 내부 대역. "피드 수집"
# YOZMNEWS_COLLECTION_ALLOWED_NETWORKS=

# 선택 — 운영자 토큰(비밀 값). 없으면 운영자 기능이 닫힌다. 32자 이상 무작위 값(예: openssl rand -hex 32). "운영자"
# YOZMNEWS_ADMIN_TOKEN=

# 선택 — Jev 모델(기본 jev-latest)과 기본 주소(기본 https://api.typesafe.ai). 값을 비운 줄은 앱의 기본값이 되지 않으므로, 쓰지 않을 때는
# 주석으로 둔다. "공유 평가"
# YOZMNEWS_JEV_MODEL=
# YOZMNEWS_JEV_BASE_URL=

# 선택 — 사건 묶기의 시간 창(예 72h) · 위 · 아래 · 저장 · 확률 기준 · 닫는 기간(예 4d) · 최대 기간. 값을 비운 줄은 앱의 기본값이
# 되지 않으므로, 쓰지 않을 때는 주석으로 둔다. "사건 묶기"
# YOZMNEWS_EVENT_ASSIGNMENT_WINDOW=
# YOZMNEWS_EVENT_ASSIGNMENT_UPPER=
# YOZMNEWS_EVENT_ASSIGNMENT_LOWER=
# YOZMNEWS_EVENT_ASSIGNMENT_STORE=
# YOZMNEWS_EVENT_ASSIGNMENT_PROBABILITY=
# YOZMNEWS_EVENT_ASSIGNMENT_CLOSE_AFTER=
# YOZMNEWS_EVENT_ASSIGNMENT_MAX_OPEN=

# 선택 — 스토리라인 잇기의 시간 창(예 14d) · 기준 점수(예 0.86). 값을 비운 줄은 앱의 기본값이 되지 않으므로, 쓰지 않을 때는
# 주석으로 둔다. "스토리라인 잇기"
# YOZMNEWS_STORYLINE_LINKING_WINDOW=
# YOZMNEWS_STORYLINE_LINKING_THRESHOLD=

# 선택 — 스토리라인 관계의 확률 기준(예 0.6) · 한 사안 기준(예 0.2) · 사건 수 하한(예 3) · 후보 점수 기준(예 0.88) · 시간 창(예 14d).
# 값을 비운 줄은 앱의 기본값이 되지 않으므로, 쓰지 않을 때는 주석으로 둔다. "스토리라인 관계"
# YOZMNEWS_STORYLINE_RELATION_PROBABILITY=
# YOZMNEWS_STORYLINE_RELATION_ONE_MATTER=
# YOZMNEWS_STORYLINE_RELATION_MIN_EVENTS=
# YOZMNEWS_STORYLINE_RELATION_CANDIDATE_SCORE=
# YOZMNEWS_STORYLINE_RELATION_WINDOW=

# 선택 — 스토리라인 상태의 잠잠 기간(예 7d) · 끝남 기간(예 30d). 잠잠 기간이 끝남 기간보다 짧아야 한다. 값을 비운 줄은 앱의
# 기본값이 되지 않으므로, 쓰지 않을 때는 주석으로 둔다. "스토리라인 상태"
# YOZMNEWS_STORYLINE_STATE_QUIET_AFTER=
# YOZMNEWS_STORYLINE_STATE_ENDED_AFTER=

# 선택 — 사건 묶기의 임베딩 방식. 기본은 이미지 안의 로컬 모델(onnx)이다. openai-compatible 로 바꾸면 기사 제목 · 요약문 앞부분이
# 그 API 로 나간다 — 주소 · 모델 · 차원은 필수, 키(비밀 값)는 API 가 요구할 때. 차원 전송 · 입력 앞 문자열 · 묶음 크기는 선택이다. 값을
# 비운 줄은 앱의 기본값이 되지 않으므로, 쓰지 않을 때는 주석으로 둔다. "사건 묶기"
# YOZMNEWS_EMBEDDING_PROVIDER=
# YOZMNEWS_EMBEDDING_OPENAI_COMPATIBLE_BASE_URL=
# YOZMNEWS_EMBEDDING_OPENAI_COMPATIBLE_MODEL=
# YOZMNEWS_EMBEDDING_OPENAI_COMPATIBLE_API_KEY=
# YOZMNEWS_EMBEDDING_OPENAI_COMPATIBLE_DIMENSIONS=
# YOZMNEWS_EMBEDDING_OPENAI_COMPATIBLE_SEND_DIMENSIONS=
# YOZMNEWS_EMBEDDING_OPENAI_COMPATIBLE_INPUT_PREFIX=
# YOZMNEWS_EMBEDDING_OPENAI_COMPATIBLE_BATCH_SIZE=

# 선택 — 작업 서버 동시 실행 수. 값을 비운 줄은 앱의 기본값이 되지 않으므로, 쓰지 않을 때는 주석으로 둔다. "백그라운드 작업"
# YOZMNEWS_JOB_WORKERS=

# 선택 — proxy 를 공개할 호스트 주소와 포트. "공개"
# PROXY_HOST_ADDRESS=
# PROXY_HOST_PORT=

# 선택 — Compose 프로젝트 이름. 바꾸면 다른 DB 볼륨을 쓴다. "Compose"
# COMPOSE_PROJECT_NAME=
