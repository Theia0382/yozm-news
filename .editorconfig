root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java와 Gradle 스크립트는 Spring Initializr 생성물과 같은 탭 들여쓰기
[*.{java,kts,gradle}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
